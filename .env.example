# Copy to .env.local for local dev, and add the same three values in your
# Vercel project under Settings → Environment Variables.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries land — the PSK Cars business inbox.
CONTACT_TO_EMAIL=you@pskcars.co.nz

# Who the email appears to come from. The domain must be verified in Resend
# (https://resend.com/domains). Before your domain is verified you can use
# onboarding@resend.dev, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=PSK Cars Website <website@pskcars.co.nz>
